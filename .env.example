VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:8787

# Free LLM provider. Groq is the default because it exposes an OpenAI-compatible API.
# Get your own key from https://console.groq.com/keys.
FREE_LLM_API_KEY=
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
FREE_LLM_MODEL=llama-3.3-70b-versatile

# Production backend services.
DATABASE_URL=postgres://projectmind:projectmind@localhost:5432/projectmind
REDIS_URL=redis://localhost:6379
SECRET_ENCRYPTION_KEY=replace-with-32-byte-production-secret

# GitHub App and OAuth.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local API server settings.
PORT=8787
WEB_ORIGIN=http://localhost:5173
